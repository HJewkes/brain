{
  "enforcement": {
    "ownership": true,
    "dod": true,
    "gitSafety": true,
    "worktreeIsolation": true,
    "brainResources": true,
    "wipLimit": 4,
    "workspaceClean": true,
    "complexityLimit": 30
  },
  "brain": {
    "global": "~/.brain",
    "local": ".brain"
  },
  "ownershipManifest": ".claude/ownership.json",
  "browserGate": {
    "agent": "deploy-agent"
  },
  "delivery": {
    "flakyTests": ["workflow-mcp.test.ts"]
  },
