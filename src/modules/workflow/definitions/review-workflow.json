{
  "version": 1,
  "name": "review",
  "description": "PR review workflow with risk-based routing",
  "steps": [
    {
      "id": "review",
      "name": "Review",
      "category": "review",
      "template": "review-agent",
      "mode": "agent"
    },
    {
      "id": "route",
      "name": "Route Decision",
      "category": "infrastructure",
      "mode": "agent",
      "metadata": { "description": "Risk-based routing: merge, fixup, or human review" }
    },
    {
      "id": "fixup",
      "name": "Fixup",
      "category": "implementation",
      "template": "review-fixup",
      "mode": "agent",
      "gates": [{ "type": "iteration", "maxIterations": 3, "description": "Max 3 fixup rounds" }]
    },
    {
      "id": "human-review",
      "name": "Human Review",
      "category": "review",
      "mode": "human",
      "gates": [{ "type": "human-approval", "description": "Human review required for high-risk changes" }]
    },
    {
      "id": "merge",
      "name": "Merge",
      "category": "infrastructure",
      "mode": "human"
    }
  ],
  "edges": [
    { "from": "review", "to": "route" },
    { "from": "route", "to": "fixup", "condition": "needs_fixes" },
    { "from": "route", "to": "human-review", "condition": "high_risk" },
    { "from": "route", "to": "merge", "condition": "approved" },
    { "from": "fixup", "to": "review" },
    { "from": "human-review", "to": "merge", "condition": "approved" },
    { "from": "human-review", "to": "fixup", "condition": "needs_fixes" }
  ],
  "parameters": [
    { "name": "prUrl", "description": "Pull request URL", "required": true },
    { "name": "branch", "description": "Feature branch name", "required": true },
    { "name": "baseBranch", "description": "Base branch to diff against", "required": false, "default": "main" }
  ]
}
