{
  "version": 2,
  "name": "implementation",
  "description": "Implementation lifecycle workflow with templates and gates",
  "steps": [
    { "id": "dispatch", "name": "Dispatch", "category": "infrastructure", "template": "implementation-compact", "mode": "agent" },
    { "id": "implement", "name": "Implement", "category": "implementation", "template": "implementation-compact", "mode": "agent" },
    {
      "id": "review",
      "name": "Review",
      "category": "review",
      "template": "review-agent",
      "mode": "agent",
      "gates": [{ "type": "approval", "description": "PR approved or risk below threshold" }]
    },
    {
      "id": "fix",
      "name": "Fix",
      "category": "implementation",
      "template": "review-fixup",
      "mode": "agent",
      "gates": [{ "type": "iteration", "maxIterations": 3, "description": "Max 3 fixup rounds" }]
    },
    { "id": "merge", "name": "Merge", "category": "infrastructure", "mode": "human" }
  ],
  "edges": [
    { "from": "dispatch", "to": "implement" },
    { "from": "implement", "to": "review" },
    { "from": "review", "to": "fix", "condition": "needs_fixes" },
    { "from": "review", "to": "merge", "condition": "approved" },
    { "from": "fix", "to": "review" }
  ]
}
