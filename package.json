{
  "name": "@titan-design/brain",
  "version": "0.7.0",
  "type": "module",
  "description": "Developer second brain with hybrid RAG search",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HJewkes/brain.git"
  },
  "files": [
    "dist",
    "skill",
    "scripts"
  ],
  "bin": {
    "brain": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup && mkdir -p dist/templates && cp src/modules/workflow/templates/*.md dist/templates/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:eval": "vitest run --project eval",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src __tests__ --no-error-on-unmatched-pattern",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "test:coverage": "vitest run --coverage",
    "postinstall": "node scripts/postinstall.js",
    "preuninstall": "node scripts/preuninstall.js",
    "lint:staged": "lint-staged"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^13.1.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "env-paths": "^3.0.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^28.1.0",
    "ollama": "^0.5.14",
    "sqlite-vec": "^0.1.6",
    "turndown": "^7.2.2"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.13.4",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.20.0",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --no-error-on-unmatched-pattern",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
